# Hostinger Production Environment Configuration
# Save a copy as '.env' on your Hostinger server

# Port setting (Hostinger Node.js manager assigns this automatically or defaults to 3000)
PORT=3000
NODE_ENV="production"

# Secret Key for JWT Authentication (Change this to a strong random string!)
JWT_SECRET="ubah_dengan_string_acak_rahasia_dan_panjang_123456"

# Domain URL on Hostinger
APP_URL="https://namadomainanda.com"

# Google Gemini AI API Key (Optional: for AI feature integration)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
